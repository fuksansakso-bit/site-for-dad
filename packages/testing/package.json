{
  "name": "@project-name/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@project-name/config": "workspace:*"
  },
  "devDependencies": {
    "@project-name/tooling": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "projectName": {
    "layer": "testing",
    "responsibility": "Synthetic, rights-free Foundation environment factories and bounded asynchronous test harness utilities.",
    "publicInterface": [
      "."
    ]
  }
}
