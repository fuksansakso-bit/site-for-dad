  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogVersionId       String               @map("catalog_version_id") @db.Uuid
  businessCatalogEntryId String               @map("business_catalog_entry_id") @db.Uuid
  publicationRecordId    String               @map("publication_record_id") @db.Uuid
  availabilityRecordId   String               @map("availability_record_id") @db.Uuid
  localPriceOverrideId   String?              @map("local_price_override_id") @db.Uuid
  sourcePriceRecordId    String?              @map("source_price_record_id") @db.Uuid
  primaryMediaAssetId    String?              @map("primary_media_asset_id") @db.Uuid
  sourceEntityHash       String               @map("source_entity_hash") @db.Char(64)
  overlayHash            String               @map("overlay_hash") @db.Char(64)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogVersion         CatalogVersion       @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  businessCatalogEntry   BusinessCatalogEntry @relation(fields: [businessCatalogEntryId], references: [id], onDelete: Restrict)
  publicationRecord      PublicationRecord    @relation(fields: [publicationRecordId], references: [id], onDelete: Restrict)
  availabilityRecord     AvailabilityRecord   @relation(fields: [availabilityRecordId], references: [id], onDelete: Restrict)
  localPriceOverride     LocalPriceOverride?  @relation(fields: [localPriceOverrideId], references: [id], onDelete: Restrict)
  sourcePriceRecord      SourcePriceRecord?   @relation(fields: [sourcePriceRecordId], references: [id], onDelete: Restrict)
  primaryMediaAsset      MediaAsset?          @relation(fields: [primaryMediaAssetId], references: [id], onDelete: Restrict)

  @@unique([catalogVersionId, businessCatalogEntryId], map: "catalog_version_entry_key")
  @@index([catalogVersionId, publicationRecordId], map: "catalog_version_entry_publication_idx")
  @@map("catalog_version_entry")
}
