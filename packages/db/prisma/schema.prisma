  status                   OrderInquiryStatus          @default(NEW)
  cartSnapshot             Json                        @map("cart_snapshot") @db.JsonB
  knownSubtotalMinor       BigInt                      @map("known_subtotal_minor") @db.BigInt
  pricingStatus            CartPricingStatus           @map("pricing_status")
  catalogVersionIds        Json                        @map("catalog_version_ids") @db.JsonB
  priceVersionIds          Json                        @map("price_version_ids") @db.JsonB
  sourceChannel            RequestSourceChannel        @default(WEB_GUEST) @map("source_channel")
  correlationId            String                      @map("correlation_id") @db.VarChar(128)
  auditContext             Json                        @map("audit_context") @db.JsonB
  version                  Int                         @default(1)
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  guestSession             GuestCartSession            @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  cart                     GuestCart                   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  items                    RequestItemSnapshot[]
  communicationEvents      RequestCommunicationEvent[]
  internalNotes            RequestInternalNote[]

  @@index([status, createdAt], map: "order_inquiry_status_created_idx")
  @@index([guestSessionId, createdAt], map: "order_inquiry_guest_created_idx")
  @@map("order_inquiry")
}

model RequestItemSnapshot {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId       String                   @map("inquiry_id") @db.Uuid
  sequence        Int
  quoteSnapshotId String                   @map("quote_snapshot_id") @db.Uuid
  previewStateId  String?                  @map("preview_state_id") @db.Uuid
  snapshot        Json                     @db.JsonB
  pricingStatus   PricingCalculationStatus @map("pricing_status")
  knownTotalMinor BigInt?                  @map("known_total_minor") @db.BigInt
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry         OrderInquiry             @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  quoteSnapshot   QuoteSnapshot            @relation(fields: [quoteSnapshotId], references: [id], onDelete: Restrict)
  previewState    StandardPreviewState?    @relation(fields: [previewStateId], references: [id], onDelete: Restrict)

  @@unique([inquiryId, sequence], map: "request_item_snapshot_sequence_key")
  @@index([quoteSnapshotId], map: "request_item_snapshot_quote_idx")
  @@map("request_item_snapshot")
}

model RequestCommunicationEvent {
  id              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId       String                        @map("inquiry_id") @db.Uuid
  type            RequestCommunicationEventType
  actorType       AuditActorType                @map("actor_type")
  actorIdentityId String?                       @map("actor_identity_id") @db.Uuid
  idempotencyKey  String?                       @map("idempotency_key") @db.VarChar(255)
  safeMetadata    Json                          @map("safe_metadata") @db.JsonB
  correlationId   String                        @map("correlation_id") @db.VarChar(128)
  createdAt       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry         OrderInquiry                  @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  actorIdentity   ActorIdentity?                @relation(fields: [actorIdentityId], references: [id], onDelete: Restrict)

  @@unique([inquiryId, idempotencyKey], map: "request_communication_event_idempotency_key")
  @@index([inquiryId, createdAt], map: "request_communication_event_inquiry_idx")
  @@map("request_communication_event")
}

model RequestInternalNote {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId      String        @map("inquiry_id") @db.Uuid
  authorActorId  String        @map("author_actor_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key") @db.VarChar(255)
  body           String        @db.VarChar(1000)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry        OrderInquiry  @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  authorActor    ActorIdentity @relation(fields: [authorActorId], references: [id], onDelete: Restrict)

  @@unique([inquiryId, idempotencyKey], map: "request_internal_note_idempotency_key")
  @@index([inquiryId, createdAt], map: "request_internal_note_inquiry_idx")
  @@map("request_internal_note")
}

model PricingVersionDecision {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priceVersionId String                       @map("price_version_id") @db.Uuid
  action         PricingVersionDecisionAction
  actorId        String                       @map("actor_id") @db.Uuid
  beforeState    Json                         @map("before_state") @db.JsonB
  afterState     Json                         @map("after_state") @db.JsonB
  safeReason     String                       @map("safe_reason") @db.VarChar(512)
  correlationId  String                       @map("correlation_id") @db.VarChar(128)
  idempotencyKey String                       @unique(map: "pricing_version_decision_idempotency_key") @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  priceVersion   PriceVersion                 @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  actor          ActorIdentity                @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([priceVersionId, createdAt], map: "pricing_version_decision_version_time_idx")
  @@map("pricing_version_decision")
}

model BusinessCatalogEntry {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType        CatalogEntityType     @map("entity_type")
  categoryId        String?               @unique(map: "business_catalog_entry_category_key") @map("category_id") @db.Uuid
  systemId          String?               @unique(map: "business_catalog_entry_system_key") @map("system_id") @db.Uuid
  materialVariantId String?               @unique(map: "business_catalog_entry_variant_key") @map("material_variant_id") @db.Uuid
  visibility        CatalogVisibility     @default(HIDDEN)
  localDescription  String?               @map("local_description") @db.Text
  localOrder        Int                   @default(0) @map("local_order")
  manualReviewState ManualReviewStatus    @default(UNREVIEWED) @map("manual_review_state")
  ownerNotes        String?               @map("owner_notes") @db.Text
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  category          ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  system            ProductSystem?        @relation(fields: [systemId], references: [id], onDelete: Restrict)
  materialVariant   MaterialVariant?      @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  availability      AvailabilityRecord[]
  priceOverrides    LocalPriceOverride[]
  publications      PublicationRecord[]
  versionEntries    CatalogVersionEntry[]

  @@index([entityType, visibility], map: "business_catalog_entry_visibility_idx")
  @@map("business_catalog_entry")
}

model AvailabilityRecord {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessCatalogEntryId String                @map("business_catalog_entry_id") @db.Uuid
  status                 AvailabilityStatus
  reason                 String?               @db.VarChar(512)
  decidedByActorId       String?               @map("decided_by_actor_id") @db.Uuid
  effectiveAt            DateTime              @default(now()) @map("effective_at") @db.Timestamptz(6)
  endedAt                DateTime?             @map("ended_at") @db.Timestamptz(6)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  businessCatalogEntry   BusinessCatalogEntry  @relation(fields: [businessCatalogEntryId], references: [id], onDelete: Restrict)
  catalogEntries         CatalogVersionEntry[]

  @@index([businessCatalogEntryId, effectiveAt], map: "availability_record_entry_time_idx")
  @@map("availability_record")
}

model LocalPriceOverride {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessCatalogEntryId String                   @map("business_catalog_entry_id") @db.Uuid
  amountMinor            Int                      @map("amount_minor")
  currency               String                   @db.Char(3)
  status                 LocalPriceOverrideStatus @default(ACTIVE)
  reason                 String                   @db.VarChar(512)
  decidedByActorId       String?                  @map("decided_by_actor_id") @db.Uuid
  effectiveFrom          DateTime                 @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime?                @map("effective_to") @db.Timestamptz(6)
  removedAt              DateTime?                @map("removed_at") @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  businessCatalogEntry   BusinessCatalogEntry     @relation(fields: [businessCatalogEntryId], references: [id], onDelete: Restrict)
  catalogEntries         CatalogVersionEntry[]

  @@index([businessCatalogEntryId, status, effectiveFrom], map: "local_price_override_active_idx")
  @@map("local_price_override")
}

model PublicationRecord {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessCatalogEntryId String                @map("business_catalog_entry_id") @db.Uuid
  status                 PublicationStatus
  reason                 String?               @db.VarChar(512)
  decidedByActorId       String?               @map("decided_by_actor_id") @db.Uuid
  effectiveAt            DateTime              @default(now()) @map("effective_at") @db.Timestamptz(6)
  endedAt                DateTime?             @map("ended_at") @db.Timestamptz(6)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  businessCatalogEntry   BusinessCatalogEntry  @relation(fields: [businessCatalogEntryId], references: [id], onDelete: Restrict)
  catalogEntries         CatalogVersionEntry[]

  @@index([businessCatalogEntryId, effectiveAt], map: "publication_record_entry_time_idx")
  @@map("publication_record")
}

model CatalogVersionEntry {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogVersionId       String               @map("catalog_version_id") @db.Uuid
  businessCatalogEntryId String               @map("business_catalog_entry_id") @db.Uuid
  publicationRecordId    String               @map("publication_record_id") @db.Uuid
  availabilityRecordId   String               @map("availability_record_id") @db.Uuid
  localPriceOverrideId   String?              @map("local_price_override_id") @db.Uuid
  sourcePriceRecordId    String?              @map("source_price_record_id") @db.Uuid
  primaryMediaAssetId    String?              @map("primary_media_asset_id") @db.Uuid
  sourceEntityHash       String               @map("source_entity_hash") @db.Char(64)
  overlayHash            String               @map("overlay_hash") @db.Char(64)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogVersion         CatalogVersion       @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  businessCatalogEntry   BusinessCatalogEntry @relation(fields: [businessCatalogEntryId], references: [id], onDelete: Restrict)
  publicationRecord      PublicationRecord    @relation(fields: [publicationRecordId], references: [id], onDelete: Restrict)
  availabilityRecord     AvailabilityRecord   @relation(fields: [availabilityRecordId], references: [id], onDelete: Restrict)
  localPriceOverride     LocalPriceOverride?  @relation(fields: [localPriceOverrideId], references: [id], onDelete: Restrict)
  sourcePriceRecord      SourcePriceRecord?   @relation(fields: [sourcePriceRecordId], references: [id], onDelete: Restrict)
  primaryMediaAsset      MediaAsset?          @relation(fields: [primaryMediaAssetId], references: [id], onDelete: Restrict)

  @@unique([catalogVersionId, businessCatalogEntryId], map: "catalog_version_entry_key")
  @@index([catalogVersionId, publicationRecordId], map: "catalog_version_entry_publication_idx")
  @@map("catalog_version_entry")
}
