{
  "name": "project-name",
  "version": "0.0.0",
  "private": true,
  "description": "PROJECT_NAME Phase 2A Next.js + Supabase application",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "architecture:check": "node tooling/scripts/check-boundaries.mjs",
    "build": "pnpm --filter @project-name/web build",
    "catalog:operator:admin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/catalog-pilot-operator.ps1 -CopyRole ADMIN",
    "catalog:operator:bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/catalog-pilot-operator.ps1",
    "catalog:operator:owner": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/catalog-pilot-operator.ps1 -CopyRole OWNER",
    "check": "pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm security:secrets",
    "ci:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/verify-foundation.ps1",
    "docs:check": "node tooling/scripts/validate-documentation.mjs",
    "dev": "pnpm --filter @project-name/web dev",
    "legacy:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/foundation-environment.ps1 -Action Start",
    "dev:reset": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/foundation-environment.ps1 -Action Reset",
    "dev:owner": "tsx tooling/scripts/dev-owner.ts",
    "dev:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/foundation-environment.ps1 -Action Status",
    "dev:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/foundation-environment.ps1 -Action Stop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @project-name/web lint",
    "migration:audit": "node tooling/phase2a/cli.mjs audit",
    "migration:export": "node tooling/phase2a/cli.mjs export",
    "migration:import": "node tooling/phase2a/cli.mjs import",
    "migration:optimize-media": "tsx tooling/phase2a/media/phase2a-media.ts optimize",
    "migration:transform": "node tooling/phase2a/cli.mjs transform",
    "migration:upload-media": "tsx tooling/phase2a/media/phase2a-media.ts upload",
    "migration:verify": "node tooling/phase2a/cli.mjs verify",
    "migration:verify-media": "tsx tooling/phase2a/media/phase2a-media.ts verify",
    "phase-scope:check": "node tooling/scripts/validate-phase-scope.mjs",
    "security:artifacts": "node tooling/scripts/scan-build-artifacts.mjs",
    "security:secrets": "node tooling/scripts/scan-secrets.mjs",
    "supabase:backup-db": "node tooling/phase2a/backup/backup-db.mjs",
    "supabase:backup-storage-manifest": "node tooling/phase2a/backup/backup-storage-manifest.mjs",
    "supabase:verify-backup": "node tooling/phase2a/backup/verify-backup.mjs",
    "test": "pnpm --filter @project-name/web test",
    "test:browser": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/browser-smoke.ps1",
    "test:catalog-browser": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/catalog-browser-acceptance.ps1",
    "test:catalog-full": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/catalog-full-acceptance.ps1",
    "test:catalog-pilot": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/catalog-pilot-acceptance.ps1",
    "test:catalog-scale": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/catalog-scale-acceptance.ps1",
    "test:coverage": "pnpm --filter @project-name/web test:coverage",
    "test:phase1e": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/phase-1e-acceptance.ps1",
    "test:storage": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/storage-integration.ps1",
    "typecheck": "pnpm --filter @project-name/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "pg": "catalog:",
    "supabase": "2.113.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
