# Phase 2C: copy to apps/web/.env.local. Never commit real values or a duplicate root env.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Public browser configuration. Publishable/anon key is not a service-role secret.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side CLI alias for migration, media upload and backup commands.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Server-only. Never add NEXT_PUBLIC_ to this name or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Migration/backup only; not required by the normal Next.js runtime.
LEGACY_DATABASE_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
MIGRATION_DATABASE_URL=
# Optional absolute local pg_dump executable used only by the ignored backup command.
PG_DUMP_PATH=
LEGACY_S3_ENDPOINT=
LEGACY_S3_REGION=local
LEGACY_S3_BUCKET=
LEGACY_S3_ACCESS_KEY_ID=
LEGACY_S3_SECRET_ACCESS_KEY=
LEGACY_S3_FORCE_PATH_STYLE=true

# Server-side public-request safeguards.
REQUEST_BODY_LIMIT_BYTES=65536
REQUEST_RATE_LIMIT_MAX=8
REQUEST_RATE_LIMIT_WINDOW_SECONDS=600

# Server-only Polza AI Media API. Never prefix these names with NEXT_PUBLIC_.
POLZA_AI_API_KEY=
POLZA_AI_BASE_URL=https://polza.ai/api/v1
POLZA_AI_IMAGE_MODEL=google/gemini-3.1-flash-image

# AI visualization is fail-closed. The mock flag is rejected in production.
AI_VISUALIZER_ENABLED=false
AI_VISUALIZER_MOCK_PROVIDER=false
AI_MAX_ATTEMPTS_PER_GUEST_PER_DAY=2
AI_GLOBAL_DAILY_JOB_LIMIT=
AI_MAX_CONCURRENT_JOBS=1
AI_OUTPUT_SIZE=1K
AI_RETENTION_HOURS=24
AI_LIVE_TEST_LIMIT=3

SUPABASE_AI_INPUTS_BUCKET=ai-inputs
SUPABASE_AI_RESULTS_BUCKET=ai-results

# Protects the daily Vercel cleanup route.
CRON_SECRET=
