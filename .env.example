# PROJECT_NAME Phase 1A local/test/CI variable inventory.
# Copy to ignored .env.local and provide only disposable local values.
# Class: server/non-secret. Required by web and worker.
APP_ENV=local
LOG_LEVEL=info

# Class: public/non-secret. Optional explicit client allowlist entry.
NEXT_PUBLIC_APP_ENV=local

# Class: server/non-secret. Web shell limits and dependency timeout.
HEALTH_CHECK_TIMEOUT_MS=2000
REQUEST_BODY_LIMIT_BYTES=1048576

# Class: server/non-secret. Separate worker process controls.
WORKER_CONCURRENCY=1
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=9464
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Class: server/secret. Use generated disposable PostgreSQL credentials; never production values.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Class: server/secret except endpoint/region/bucket/TTL. Use only the disposable local emulator.
S3_ENDPOINT=http://127.0.0.1:4569
S3_REGION=local
S3_BUCKET_PUBLIC=project-name-local-public
S3_BUCKET_PRIVATE=project-name-local-private
S3_BUCKET_QUARANTINE=project-name-local-quarantine
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_MAX_OBJECT_BYTES=1048576
S3_REQUEST_TIMEOUT_MS=3000
SIGNED_URL_TTL_SECONDS=300

# Class: server/secret. Generate per local/test environment; no fixed fallback is accepted.
SESSION_SIGNING_KEY=
SYNTHETIC_IDENTITY_ENABLED=true

# Class: server. Endpoint is non-secret; headers are secret. Both are optional for local no-op export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
