generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  GUEST
  CUSTOMER
  MANAGER
  ADMIN
  OWNER
  SYSTEM_WORKER

  @@map("system_role")
}

enum AuditActorType {
  ANONYMOUS
  IDENTITY
  SYSTEM_WORKER

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED

  @@map("audit_outcome")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

enum IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED

  @@map("idempotency_status")
}

enum ServiceHealthStatus {
  READY
  NOT_READY
  STOPPING

  @@map("service_health_status")
}

enum CatalogSourceType {
  PARTNER_API
  PARTNER_EXPORT
  PARTNER_FILE
  PARTNER_PORTAL
  AUTHORIZED_PUBLIC_WEB
  MANUAL_MANIFEST
  FIXTURE

  @@map("catalog_source_type")
}

enum SupplierRelationshipStatus {
  AUTHORIZED_PARTNER_SOURCE
  REVOKED

  @@map("supplier_relationship_status")
}

enum SourceSnapshotStatus {
  CAPTURED
  NOT_MODIFIED
  FAILED

  @@map("source_snapshot_status")
}

enum SourceEntityType {
  CATEGORY
  FAMILY
  SYSTEM
  MODEL
  MATERIAL
  MATERIAL_VARIANT
  COLOR
  PROPERTY
  MEDIA
  PRICE

  @@map("source_entity_type")
}

enum SourceEntityStatus {
  ACTIVE
  SOURCE_REMOVED
  PARSE_ERROR

  @@map("source_entity_status")
}

enum CatalogSyncTrigger {
  AUTOMATIC
  MANUAL
  TEST

  @@map("catalog_sync_trigger")
}

enum CatalogSyncStatus {
  QUEUED
  DISCOVERING
  CAPTURING
  NORMALIZING
  IMPORTING_MEDIA
  BUILDING_DIFF
  AWAITING_APPROVAL
  COMPLETED
  PARTIAL_FAILED
  CANCELLED
  FAILED

  @@map("catalog_sync_status")
}

enum CatalogSyncItemStatus {
  PENDING
  UNCHANGED
  CREATED
  UPDATED
  SOURCE_REMOVED
  PARSE_ERROR
  MEDIA_ERROR
  FAILED

  @@map("catalog_sync_item_status")
}

enum CatalogSyncCheckpointStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED

  @@map("catalog_sync_checkpoint_status")
}

enum CatalogImportManifestStatus {
  COMPLETE
  PARTIAL_FAILED
  CANCELLED

  @@map("catalog_import_manifest_status")
}

enum CatalogDifferenceType {
  NEW_CATEGORY
  NEW_SYSTEM
  NEW_MODEL
  NEW_MATERIAL
  ARTICLE_CHANGED
  COLOR_CHANGED
  PROPERTY_CHANGED
  NEW_MEDIA
  PRICE_CHANGED
  SOURCE_REMOVED
  PARSE_ERROR

  @@map("catalog_difference_type")
}

enum CatalogDifferenceResolution {
  PENDING
  DEFERRED
  KEEP
  HIDE
  ARCHIVE
  REPLACE
  RESTORE
  APPROVED
  REJECTED

  @@map("catalog_difference_resolution")
}

enum CatalogDifferenceReviewScope {
  CATALOG
  PRICE

  @@map("catalog_difference_review_scope")
}

enum CatalogDifferenceSelectionMode {
  ALL
  SELECTED

  @@map("catalog_difference_selection_mode")
}

enum CatalogBulkSelectorMode {
  CATEGORY
  FILTER
  SELECTED

  @@map("catalog_bulk_selector_mode")
}

enum CatalogVersionStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  ACTIVE
  SUPERSEDED
  REJECTED

  @@map("catalog_version_status")
}

enum CatalogEntityType {
  CATEGORY
  SYSTEM
  MATERIAL_VARIANT

  @@map("catalog_entity_type")
}

enum CatalogVisibility {
  VISIBLE
  HIDDEN

  @@map("catalog_visibility")
}

enum AvailabilityStatus {
  UNREVIEWED
  AVAILABLE
  OUT_OF_STOCK
  INQUIRY_ONLY
  HIDDEN

  @@map("availability_status")
}

enum PublicationStatus {
  UNREVIEWED
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED

  @@map("publication_status")
}

enum ManualReviewStatus {
  UNREVIEWED
  APPROVED
  NEEDS_REVIEW
  REJECTED

  @@map("manual_review_status")
}

enum MediaAssetRole {
  PRIMARY
  DETAIL
  SWATCH
  SYSTEM

  @@map("media_asset_role")
}

enum MediaRightsStatus {
  REFERENCE_ONLY
  PERMISSION_PENDING
  PARTNER_LICENSE
  OWNER_CREATED
  CLIENT_CONSENT
  PUBLICATION_BLOCKED

  @@map("media_rights_status")
}

enum MediaPublicationStatus {
  PENDING
  PUBLICATION_APPROVED
  PUBLICATION_BLOCKED

  @@map("media_publication_status")
}

enum PriceStatus {
  AVAILABLE
  PRICE_ON_REQUEST

  @@map("price_status")
}

enum PriceRecordKind {
  FROM
  BASE

  @@map("price_record_kind")
}

enum PriceVersionStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  ACTIVE
  SUPERSEDED
  REJECTED

  @@map("price_version_status")
}

enum LocalPriceOverrideStatus {
  ACTIVE
  REMOVED
  SCHEDULED
  EXPIRED

  @@map("local_price_override_status")
}

enum PricingRuleKind {
  EXACT_LOOKUP
  AREA_MINIMUM

  @@map("pricing_rule_kind")
}

enum PricingRuleVerificationStatus {
  CANDIDATE
  VERIFIED
  REJECTED

  @@map("pricing_rule_verification_status")
}

enum PricingParityStatus {
  PENDING
  PASSED
  FAILED

  @@map("pricing_parity_status")
}

enum PricingCalculationStatus {
  CALCULATED
  PRICE_ON_REQUEST
  MANUAL_REVIEW_REQUIRED
  CONFIGURATION_INVALID
  SOURCE_DATA_STALE
  PRICE_VERSION_INACTIVE
  DEPENDENCY_UNAVAILABLE

  @@map("pricing_calculation_status")
}

enum PricingVersionDecisionAction {
  ACTIVATE
  REJECT
  PARITY_VERIFY

  @@map("pricing_version_decision_action")
}

enum PreviewAssetQuality {
  EXACT_SWATCH
  PRODUCT_IMAGE_CROP
  NORMALIZED_COLOR_ONLY
  PREVIEW_UNAVAILABLE

  @@map("preview_asset_quality")
}

enum GuestCartStatus {
  ACTIVE
  CHECKED_OUT
  EXPIRED

  @@map("guest_cart_status")
}

enum CartItemRevisionAction {
  ADDED
  REPLACED
  DUPLICATED
  REMOVED
  CLEARED

  @@map("cart_item_revision_action")
}

enum CartPricingStatus {
  FULLY_PRICED
  PARTIALLY_PRICED
  PRICE_ON_REQUEST

  @@map("cart_pricing_status")
}

enum OrderInquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CONFIRMED
  CANCELLED

  @@map("order_inquiry_status")
}

enum RequestCommunicationEventType {
  REQUEST_CREATED
  WHATSAPP_LINK_GENERATED
  WHATSAPP_LINK_OPENED
  MESSAGE_COPIED
  STATUS_CHANGED

  @@map("request_communication_event_type")
}

enum RequestSourceChannel {
  WEB_GUEST

  @@map("request_source_channel")
}

model ActorIdentity {
  id                         String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                   String                         @db.VarChar(64)
  subject                    String                         @db.VarChar(255)
  disabledAt                 DateTime?                      @map("disabled_at") @db.Timestamptz(6)
  createdAt                  DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  roleGrants                 RoleGrant[]                    @relation("role_target")
  grantsAuthored             RoleGrant[]                    @relation("role_granter")
  sessions                   SyntheticSession[]
  requestCommunicationEvents RequestCommunicationEvent[]
  requestInternalNotes       RequestInternalNote[]
  auditEvents                AuditEvent[]
  catalogDifferenceReviews   CatalogDifferenceReviewBatch[]
  catalogBulkCommands        CatalogBulkCommand[]
  pricingParityRuns          PricingParityRun[]
  pricingVersionDecisions    PricingVersionDecision[]

  @@unique([provider, subject], map: "actor_identity_provider_subject_key")
  @@map("actor_identity")
}

model RoleGrant {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId          String         @map("actor_id") @db.Uuid
  role             SystemRole
  grantedByActorId String?        @map("granted_by_actor_id") @db.Uuid
  grantedAt        DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(6)
  actor            ActorIdentity  @relation("role_target", fields: [actorId], references: [id], onDelete: Restrict)
  grantedByActor   ActorIdentity? @relation("role_granter", fields: [grantedByActorId], references: [id], onDelete: Restrict)

  @@unique([actorId, role], map: "role_grant_actor_role_key")
  @@index([grantedByActorId], map: "role_grant_granter_idx")
  @@map("role_grant")
}

model SyntheticSession {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String        @map("actor_id") @db.Uuid
  tokenHash  String        @unique(map: "synthetic_session_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      ActorIdentity @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, expiresAt], map: "synthetic_session_actor_expiry_idx")
  @@map("synthetic_session")
}

model AuditEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt      DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorType       AuditActorType @map("actor_type")
  actorIdentityId String?        @map("actor_identity_id") @db.Uuid
  action          String         @db.VarChar(128)
  outcome         AuditOutcome
  correlationId   String         @map("correlation_id") @db.VarChar(128)
  requestId       String?        @map("request_id") @db.VarChar(128)
  targetType      String?        @map("target_type") @db.VarChar(128)
  targetId        String?        @map("target_id") @db.VarChar(255)
  reasonCode      String?        @map("reason_code") @db.VarChar(128)
  actorIdentity   ActorIdentity? @relation(fields: [actorIdentityId], references: [id], onDelete: Restrict)

  @@index([actorIdentityId, occurredAt], map: "audit_event_actor_time_idx")
  @@index([correlationId], map: "audit_event_correlation_idx")
  @@index([action, occurredAt], map: "audit_event_action_time_idx")
  @@map("audit_event")
}

model OutboxEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic          String       @db.VarChar(128)
  schemaVersion  Int          @default(1) @map("schema_version") @db.SmallInt
  payload        Json         @db.JsonB
  idempotencyKey String       @unique(map: "outbox_event_idempotency_key_key") @map("idempotency_key") @db.VarChar(255)
  correlationId  String       @map("correlation_id") @db.VarChar(128)
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  lastErrorCode  String?      @map("last_error_code") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt], map: "outbox_event_delivery_idx")
  @@map("outbox_event")
}

model IdempotencyRecord {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope         String            @db.VarChar(128)
  key           String            @db.VarChar(255)
  payloadDigest String            @map("payload_digest") @db.Char(64)
  resultDigest  String?           @map("result_digest") @db.Char(64)
  status        IdempotencyStatus @default(IN_PROGRESS)
  lockedUntil   DateTime?         @map("locked_until") @db.Timestamptz(6)
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, key], map: "idempotency_record_scope_key_key")
  @@index([status, lockedUntil], map: "idempotency_record_lock_idx")
  @@map("idempotency_record")
}

model ServiceHeartbeat {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceName String              @map("service_name") @db.VarChar(64)
  instanceId  String              @map("instance_id") @db.VarChar(128)
  status      ServiceHealthStatus
  observedAt  DateTime            @map("observed_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([serviceName, instanceId], map: "service_heartbeat_service_instance_key")
  @@index([status, observedAt], map: "service_heartbeat_status_time_idx")
  @@map("service_heartbeat")
}

model Supplier {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String                 @unique(map: "supplier_slug_key") @db.VarChar(96)
  name           String                 @db.VarChar(255)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  relationships  SupplierRelationship[]
  catalogSources CatalogSource[]

  @@map("supplier")
}

model SupplierRelationship {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId                 String                     @map("supplier_id") @db.Uuid
  version                    Int
  status                     SupplierRelationshipStatus
  partnerName                String                     @map("partner_name") @db.VarChar(255)
  partnerRegion              String?                    @map("partner_region") @db.VarChar(255)
  partnerBadgeAssetId        String?                    @map("partner_badge_asset_id") @db.Uuid
  permissionScope            Json                       @map("permission_scope") @db.JsonB
  permissionConfirmedByOwner Boolean                    @map("permission_confirmed_by_owner")
  permissionRecordedAt       DateTime                   @map("permission_recorded_at") @db.Timestamptz(6)
  optionalEvidenceReference  String?                    @map("optional_evidence_reference") @db.VarChar(512)
  brandUsageNotes            String?                    @map("brand_usage_notes") @db.Text
  effectiveAt                DateTime                   @map("effective_at") @db.Timestamptz(6)
  revokedAt                  DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  supplier                   Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  partnerBadgeAsset          MediaAsset?                @relation(fields: [partnerBadgeAssetId], references: [id], onDelete: Restrict)
  catalogSources             CatalogSource[]

  @@unique([supplierId, version], map: "supplier_relationship_supplier_version_key")
  @@index([supplierId, status], map: "supplier_relationship_status_idx")
  @@map("supplier_relationship")
}

model CatalogSource {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId             String               @map("supplier_id") @db.Uuid
  supplierRelationshipId String               @map("supplier_relationship_id") @db.Uuid
  sourceType             CatalogSourceType    @map("source_type")
  name                   String               @db.VarChar(160)
  baseUrl                String               @map("base_url") @db.VarChar(512)
  parserVersion          String               @map("parser_version") @db.VarChar(64)
  mappingVersion         String               @map("mapping_version") @db.VarChar(64)
  maximumConcurrency     Int                  @default(1) @map("maximum_concurrency") @db.SmallInt
  minimumDelayMs         Int                  @default(1000) @map("minimum_delay_ms")
  enabled                Boolean              @default(true)
  lastCheckedAt          DateTime?            @map("last_checked_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier               Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierRelationship   SupplierRelationship @relation(fields: [supplierRelationshipId], references: [id], onDelete: Restrict)
  snapshots              SourceSnapshot[]
  entities               SourceEntity[]
  syncRuns               CatalogSyncRun[]
  mediaAssets            SourceMediaAsset[]
  priceRecords           SourcePriceRecord[]
  bulkCommands           CatalogBulkCommand[]

  @@unique([supplierId, sourceType, name], map: "catalog_source_identity_key")
  @@index([supplierRelationshipId], map: "catalog_source_relationship_idx")
  @@map("catalog_source")
}

model SourceSnapshot {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogSourceId String               @map("catalog_source_id") @db.Uuid
  syncRunId       String               @map("sync_run_id") @db.Uuid
  sourceEntityId  String?              @map("source_entity_id") @db.Uuid
  captureKey      String               @map("capture_key") @db.VarChar(512)
  sourceUrl       String               @map("source_url") @db.VarChar(1024)
  capturedAt      DateTime             @map("captured_at") @db.Timestamptz(6)
  status          SourceSnapshotStatus
  httpStatus      Int?                 @map("http_status") @db.SmallInt
  contentHash     String               @map("content_hash") @db.Char(64)
  safePayload     Json                 @map("safe_payload") @db.JsonB
  parserVersion   String               @map("parser_version") @db.VarChar(64)
  mappingVersion  String               @map("mapping_version") @db.VarChar(64)
  sourceVersion   String?              @map("source_version") @db.VarChar(160)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogSource   CatalogSource        @relation(fields: [catalogSourceId], references: [id], onDelete: Restrict)
  syncRun         CatalogSyncRun       @relation(fields: [syncRunId], references: [id], onDelete: Restrict)
  sourceEntity    SourceEntity?        @relation(fields: [sourceEntityId], references: [id], onDelete: Restrict)
  syncItems       CatalogSyncItem[]

  @@unique([syncRunId, captureKey], map: "source_snapshot_run_capture_key")
  @@index([catalogSourceId, capturedAt], map: "source_snapshot_source_time_idx")
  @@index([contentHash], map: "source_snapshot_hash_idx")
  @@map("source_snapshot")
}

model SourceEntity {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogSourceId      String                  @map("catalog_source_id") @db.Uuid
  sourceType           SourceEntityType        @map("source_type")
  sourceId             String                  @map("source_id") @db.VarChar(255)
  sourceSlug           String                  @map("source_slug") @db.VarChar(255)
  sourceUrl            String                  @map("source_url") @db.VarChar(1024)
  sourceCategory       String?                 @map("source_category") @db.VarChar(255)
  sourceHash           String                  @map("source_hash") @db.Char(64)
  sourceCapturedAt     DateTime                @map("source_captured_at") @db.Timestamptz(6)
  sourceLastVerifiedAt DateTime                @map("source_last_verified_at") @db.Timestamptz(6)
  status               SourceEntityStatus      @default(ACTIVE)
  safeSourceData       Json                    @map("safe_source_data") @db.JsonB
  removedAt            DateTime?               @map("removed_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  catalogSource        CatalogSource           @relation(fields: [catalogSourceId], references: [id], onDelete: Restrict)
  snapshots            SourceSnapshot[]
  syncItems            CatalogSyncItem[]
  differences          CatalogSyncDifference[]
  family               ProductFamily?
  category             ProductCategory?
  system               ProductSystem?
  model                ProductModel?
  material             Material?
  color                Color?
  materialVariant      MaterialVariant?
  materialProperty     MaterialProperty?
  compatibilityRule    CompatibilityRule?
  dimensionConstraint  DimensionConstraint?
  sourceMediaAssets    SourceMediaAsset[]
  sourcePriceRecords   SourcePriceRecord[]

  @@unique([catalogSourceId, sourceType, sourceId], map: "source_entity_stable_identity_key")
  @@index([catalogSourceId, status], map: "source_entity_status_idx")
  @@index([sourceHash], map: "source_entity_hash_idx")
  @@map("source_entity")
}

model CatalogSyncRun {
  id                       String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalogSourceId          String                         @map("catalog_source_id") @db.Uuid
  trigger                  CatalogSyncTrigger
  status                   CatalogSyncStatus              @default(QUEUED)
  idempotencyKey           String                         @unique(map: "catalog_sync_run_idempotency_key") @map("idempotency_key") @db.VarChar(255)
  correlationId            String                         @map("correlation_id") @db.VarChar(128)
  requestedByActorId       String?                        @map("requested_by_actor_id") @db.Uuid
  startedAt                DateTime?                      @map("started_at") @db.Timestamptz(6)
  completedAt              DateTime?                      @map("completed_at") @db.Timestamptz(6)
  lastHeartbeatAt          DateTime?                      @map("last_heartbeat_at") @db.Timestamptz(6)
  attempt                  Int                            @default(0)
  discoveredCount          Int                            @default(0) @map("discovered_count")
  processedCount           Int                            @default(0) @map("processed_count")
  errorCount               Int                            @default(0) @map("error_count")
  parserVersion            String                         @map("parser_version") @db.VarChar(64)
  mappingVersion           String                         @map("mapping_version") @db.VarChar(64)
  sourceVersion            String?                        @map("source_version") @db.VarChar(160)
  errorCode                String?                        @map("error_code") @db.VarChar(128)
  cancelRequestedAt        DateTime?                      @map("cancel_requested_at") @db.Timestamptz(6)
  cancelRequestedByActorId String?                        @map("cancel_requested_by_actor_id") @db.Uuid
  cancellationReason       String?                        @map("cancellation_reason") @db.VarChar(512)
  cancelledAt              DateTime?                      @map("cancelled_at") @db.Timestamptz(6)
  auditContext             Json                           @map("audit_context") @db.JsonB
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  catalogSource            CatalogSource                  @relation(fields: [catalogSourceId], references: [id], onDelete: Restrict)
  snapshots                SourceSnapshot[]
  items                    CatalogSyncItem[]
  differences              CatalogSyncDifference[]
  differenceReviewBatches  CatalogDifferenceReviewBatch[]
  bulkCommands             CatalogBulkCommand[]
  checkpoints              CatalogSyncCheckpoint[]
  importManifest           CatalogImportManifest?
  catalogVersions          CatalogVersion[]
  priceVersions            PriceVersion[]

  @@index([catalogSourceId, createdAt], map: "catalog_sync_run_source_time_idx")
  @@index([status, createdAt], map: "catalog_sync_run_status_idx")
  @@map("catalog_sync_run")
}

model CatalogSyncItem {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncRunId      String                @map("sync_run_id") @db.Uuid
  sourceEntityId String?               @map("source_entity_id") @db.Uuid
  snapshotId     String?               @map("snapshot_id") @db.Uuid
  sourceType     SourceEntityType      @map("source_type")
  sourceId       String                @map("source_id") @db.VarChar(255)
  status         CatalogSyncItemStatus @default(PENDING)
  stage          String                @db.VarChar(64)
  progress       Int                   @default(0) @db.SmallInt
  beforeHash     String?               @map("before_hash") @db.Char(64)
  afterHash      String?               @map("after_hash") @db.Char(64)
  errorCode      String?               @map("error_code") @db.VarChar(128)
  safeMetadata   Json?                 @map("safe_metadata") @db.JsonB
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
